{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^unity-deps\\.txt$/"
      ],
      "matchStrings": [
        "(?<depName>com\\.unity\\.[a-z]+)=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "unity3d-packages",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^nextcloud-deps\\.txt$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z_]+)=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "nextcloud",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "unity3d-packages"
      ],
      "groupName": "Unity package changelog comparison"
    },
    {
      "matchPackageNames": [
        "com.unity.inputsystem"
      ],
      "allowedVersions": "<=1.15.0"
    },
    {
      "matchPackageNames": [
        "com.unity.cinemachine"
      ],
      "allowedVersions": "<=3.1.2"
    },
    {
      "matchDatasources": [
        "nextcloud"
      ],
      "registryUrls": [
        "https://apps.nextcloud.com/api/v1/platform/30.0.0/apps.json"
      ],
      "groupName": "Nextcloud app changelog comparison"
    },
    {
      "matchDatasources": [
        "nextcloud"
      ],
      "matchPackageNames": [
        "calendar"
      ],
      "allowedVersions": "<=5.5.9"
    },
    {
      "matchDatasources": [
        "nextcloud"
      ],
      "matchPackageNames": [
        "contacts"
      ],
      "allowedVersions": "<=7.3.9"
    }
  ],
  "automerge": false
}
